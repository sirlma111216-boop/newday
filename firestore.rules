rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/calendar/main {
      function owner() {
        // Firebase Authentication 사용자 목록의 본인 UID로 교체하세요.
        return request.auth != null && request.auth.uid == userId
          && request.auth.uid == 'REPLACE_WITH_YOUR_UID';
      }
      function valid() {
        return request.resource.data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 900000
          && request.resource.data.revision is int
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid()
        && request.resource.data.revision == resource.data.revision + 1;
      // 달력 비우기는 문서를 삭제하지 않고 빈 데이터를 저장합니다.
      allow delete: if false;
    }
  }
}
