rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/calendar/main {
      function owner() {
        // 로그인한 본인의 경로에만 접근할 수 있습니다.
        // 예전에는 여기에 UID를 직접 적어 두었는데, 그 값을 바꾸지 않고 배포하면
        // 본인도 막히고 공유받는 사람도 로그인할 수 없어 표준 방식으로 바꿨습니다.
        return request.auth != null && request.auth.uid == userId;
      }
      function valid() {
        return request.resource.data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 900000
          && request.resource.data.revision is int
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid()
        && request.resource.data.revision == resource.data.revision + 1;
      // 달력 비우기는 문서를 삭제하지 않고 빈 데이터를 저장합니다.
      allow delete: if false;
    }

    // 일정 공유: 공유 번호를 아는 '로그인한' 사용자만 읽을 수 있습니다.
    // 쓰기는 만든 본인만 가능하므로 보는 사람은 고치거나 지울 수 없습니다.
    match /shares/{code} {
      function signedIn() {
        return request.auth != null;
      }
      function mine() {
        return request.auth != null && request.auth.uid == resource.data.ownerUid;
      }
      function validShare() {
        return request.resource.data.keys().hasOnly(['payload', 'label', 'ownerUid', 'updatedAt'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 900000
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 200
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if signedIn();
      allow create: if signedIn() && validShare();
      allow update: if signedIn() && mine() && validShare();
      allow delete: if signedIn() && mine();
    }
  }
}
